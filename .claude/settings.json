{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(mvn *)",
      "Bash(./.github/scripts/*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git rev-parse *)",
      "Edit(/.claude/skills/requirements-traceability/**)",
      "Bash(mvn -q test-compile -pl sdd-api)",
      "Bash(mvn test-compile *)",
      "Bash(mvn -q test-compile)",
      "Bash(mvn test *)",
      "Bash(mvn -f /Users/loiane/Development/sdd-spring-angular-example/sdd-api/pom.xml test)",
      "Edit(/.claude/skills/spring-boot-4-conventions/**)",
      "Edit(/.claude/skills/spring-code-review-rubric/**)",
      "Edit(/.claude/skills/spring-task-decomposition/**)",
      "Bash(jar -tf ~/.m2/repository/org/springframework/boot/spring-boot-test/4.0.6/spring-boot-test-4.0.6.jar)",
      "Bash(jar -tf ~/.m2/repository/org/springframework/boot/spring-boot-test-autoconfigure/4.0.6/spring-boot-test-autoconfigure-4.0.6.jar)",
      "Bash(xargs -I{} jar -tf {})",
      "Bash(mvn dependency:tree -Dincludes=org.springframework.boot:spring-boot-test)",
      "Bash(jar -tf ~/.m2/repository/org/springframework/boot/spring-boot-webmvc-test/4.0.6/spring-boot-webmvc-test-4.0.6.jar)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(mvn * -DskipTests*)",
      "Bash(mvn * -Dpit.skip*)",
      "Bash(mvn * --no-verify*)",
      "Bash(git * --no-verify*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "command": ".claude/hooks/block-impl-without-failing-test.sh"
      },
      {
        "matcher": "Edit|Write",
        "command": ".claude/hooks/enforce-files-in-scope.sh"
      },
      {
        "matcher": "Edit|Write",
        "command": ".claude/hooks/block-progress-on-open-questions.sh"
      },
      {
        "matcher": "Bash",
        "command": ".claude/hooks/forbid-skip-flags.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "command": ".claude/hooks/auto-format-touched.sh"
      },
      {
        "matcher": "Edit|Write",
        "command": ".claude/hooks/log-tdd-state-transition.sh"
      }
    ],
    "UserPromptSubmit": [
      {
        "command": ".claude/hooks/route-natural-language-aliases.sh"
      }
    ]
  }
}
